# Copy this file to .env and edit.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/daraga_civil_registry
SECRET_KEY=change-this-secret-key

# Daraga LGU office server (Dell PowerEdge T360, Windows Server 2022):
#   Computer name: WIN-HIL0JNDFJIIN
# On that server, leave these empty to use C:\CivilRegistryData and C:\CivilRegistryBackups.
# From another office PC, use the shares (IT must create them):
# DARAGA_DATA_ROOT=\\WIN-HIL0JNDFJIIN\CivilRegistryData
# DARAGA_BACKUP_ROOT=\\WIN-HIL0JNDFJIIN\CivilRegistryBackups
DARAGA_DATA_ROOT=
DARAGA_BACKUP_ROOT=
# Optional override if the computer name changes:
# DARAGA_LGU_SERVER_NAME=WIN-HIL0JNDFJIIN
